FROM node:24.14.1-alpine@sha256:8510330d3eb72c804231a834b1a8ebb55cb3796c3e4431297a24d246b8add4d5 AS build
WORKDIR /app
RUN apk add --no-cache openssl
COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/emails/package.json packages/emails/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/backend-core/package.json packages/backend-core/package.json
COPY packages/integrations/package.json packages/integrations/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
RUN npm ci --ignore-scripts --no-fund
COPY . .
RUN npm run backend:build
RUN npm prune --omit=dev --ignore-scripts --no-fund
RUN MEO_BOOTSTRAP=false node apps/api/dist/main.mjs

FROM node:24.14.1-alpine@sha256:8510330d3eb72c804231a834b1a8ebb55cb3796c3e4431297a24d246b8add4d5
WORKDIR /app
RUN apk add --no-cache openssl && mkdir -p /app/var/backend && chown node:node /app/var/backend
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps ./apps
COPY --from=build /app/package.json ./package.json
USER node
EXPOSE 4000 4001
CMD ["node","apps/api/dist/main.mjs"]
