  "narrative": {
    "northStar": "A contemporary object shop",
    "overview": "The confirmed world pairs cream, olive and terracotta with contemporary Christian objects. The implemented system reads as a quiet design shop: warm paper, precise sans typography, generous imagery and useful commerce controls. The phrase above is a code-led interpretation, not a separately approved brand metaphor.\n\nThe interface uses open product layouts and restrained panels for purchasing, account and support tasks. Generated conceptual product imagery supplies tactile filament texture. Three home compositions test the same visual world; none is recorded as the chosen composition or as a global layout requirement.",
    "keyCharacteristics": [
      "Warm paper grounds with olive structure and selective terracotta accents.",
      "Manrope headlines paired with DM Sans controls and reading text.",
      "Flat product listings, restrained rounded panels and authored stroke icons.",
      "Compact state feedback with a reduced-motion override."
    ],
    "rules": [
      {
        "name": "The Olive Structure Rule",
        "body": "Use olive for primary actions, selected controls and the main structural accent. Keep terracotta for secondary emphasis and contextual status.",
        "section": "colors"
      },
      {
        "name": "The Two Families Rule",
        "body": "Use Manrope for display and headings; use DM Sans for reading, controls, prices and product-card names.",
        "section": "typography"
      },
      {
        "name": "The Flat Product Rule",
        "body": "Keep product listings flat at rest. Reserve diffuse shadows for the drawer and toast rather than placing every product inside a raised card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep primary actions olive and preserve visible keyboard focus.",
      "Do use tactile product imagery and retain its conceptual-image disclosure.",
      "Do use flat product grids and tonal panels to distinguish reading from task areas.",
      "Do stack major task columns on mobile and retain a two-column product grid.",
      "Do place the product-detail category badge below the product title.",
      "Do preserve the reduced-motion override for transitions and animations."
    ],
    "donts": [
      "Don't use terracotta as the default primary purchase-action color.",
      "Don't replace the authored SVG stroke icons with font glyphs.",
      "Don't inherit the prototype picker’s system font, glass treatment or pill shape as storefront brand primitives.",
      "Don't promote one home composition into a universal layout rule before a direction is chosen."
    ]
  }
}
