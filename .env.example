# demo: funcionamento local com registros fictícios no navegador.
# http: o frontend utiliza a API; nenhuma escrita fictícia é usada como fallback.
NEXT_PUBLIC_DATA_MODE=demo

# Padrão: proxy de mesma origem do Next.js. Não coloque segredos em NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Somente servidor. Necessário em modo http, com o prefixo da versão incluído.
# API_BASE_URL=https://api.sua-empresa.com/api/v1

# Usado por canonical, sitemap e Open Graph em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosts HTTPS de imagens da API, separados por vírgulas (sem protocolo).
# IMAGE_HOSTS=cdn.sua-empresa.com

# Opcional: distribuição standalone em Linux/contêiner.
# NEXT_STANDALONE=true

# Chave pública do Mercado Pago para tokenização pelo Card Payment Brick.
# A chave privada existe somente na API NestJS / Railway.
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-public-key

# Mesmo secret privado no web e API. Nunca use NEXT_PUBLIC_ para ele.
# BFF_SHARED_SECRET=gere-um-secret-aleatorio-de-pelo-menos-32-caracteres
