# Copie para um arquivo privado; não inclua chaves reais no Git.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://:PASSWORD@HOST:6379/0
PUBLIC_WEB_URL=https://sua-loja.example
PUBLIC_API_URL=https://sua-api.example
SESSION_SECRET=SUBSTITUA_POR_48_BYTES_ALEATORIOS_EM_HEX
BFF_SHARED_SECRET=SUBSTITUA_POR_OUTROS_48_BYTES_ALEATORIOS_EM_HEX
TOKEN_ENCRYPTION_KEY=SUBSTITUA_POR_32_BYTES_ALEATORIOS_EM_BASE64
INTEGRATIONS_MODE=live
QUEUE_PREFIX=meo
PAYMENTS_ENABLED=false
SPLIT_PAYMENT_ENABLED=false
EMAIL_ENABLED=false
EMAIL_FROM=pedidos@seu-dominio.example
EMAIL_REPLY_TO=ajuda@seu-dominio.example
ME_SANDBOX=true
LOCAL_DATA_DIR=/app/var/backend
# Porta: Railway injeta PORT. No worker não configure WORKER_PORT para usar PORT.
