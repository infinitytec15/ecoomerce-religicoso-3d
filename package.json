{
  "name": "maos-em-oracao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck --workspace @maos-em-oracao/emails",
    "emails:preview": "node scripts/render-email-previews.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "check": "npm run typecheck && npm run lint && npm test && npm run emails:preview && npm run build && npm run build-storybook",
    "format": "prettier --write src packages scripts .storybook docs next.config.ts vitest.config.ts eslint.config.mjs package.json tsconfig.json .prettierrc.json .github/workflows/ci.yml README.md",
    "format:check": "prettier --check src packages scripts .storybook docs next.config.ts vitest.config.ts eslint.config.mjs package.json tsconfig.json .prettierrc.json .github/workflows/ci.yml README.md"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "1.0.7",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.107.1",
    "fflate": "0.8.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "three": "0.187.0",
    "tus-js-client": "4.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0",
    "@maos-em-oracao/contracts": "*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/nextjs-vite": "10.6.6",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "6.2.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "storybook": "10.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "workspaces": [
    "packages/*"
  ]
}
